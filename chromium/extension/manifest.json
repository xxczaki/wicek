{
	"manifest_version": 3,
	"name": "Wicek login fill",
	"version": "1.0.0",
	"description": "Replaces Wicek login placeholders with the real values inside the page, before the page encrypts or sends them.",
	"key": "",
	"background": { "service_worker": "background.js" },
	"content_scripts": [
		{
			"matches": ["https://*/*"],
			"js": ["content.js"],
			"all_frames": true,
			"run_at": "document_start"
		}
	],
	"host_permissions": ["http://logins.broker/*"]
}
